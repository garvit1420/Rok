# Copy to .env and fill in. Gmail: enable 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords (free).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-char-app-password
# Optional
# MAIL_FROM="MBM Placement Cell" <yourname@gmail.com>
# APP_URL=http://localhost:5173
# JWT_SECRET=change-me
# ANTHROPIC_API_KEY=
